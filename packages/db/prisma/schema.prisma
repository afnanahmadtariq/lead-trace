generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String         @id
  name             String
  email            String         @unique
  emailVerified    Boolean        @default(false)
  image            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  twoFactorEnabled Boolean?       @default(false)
  sessions         Session[]
  accounts         Account[]
  twoFactors       TwoFactor[]
  members          Member[]
  invitations      Invitation[]
  createdProspects Prospect[]
  createdOffers    Offer[]
  researchRuns     ResearchRun[]
  notifications    Notification[]
  briefShares      BriefShare[]

  @@map("user")
}

model Session {
  id                   String        @id
  expiresAt            DateTime
  token                String        @unique
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?
  activeOrganization   Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)
  mfaVerifiedAt        DateTime?

  @@index([userId])
  @@index([activeOrganizationId])
  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

// Better Auth organizations are Lead Trace workspaces and the tenant boundary
// for all prospect, research, evidence, and brief data added later.
model Organization {
  id              String           @id
  name            String
  slug            String           @unique
  logo            String?
  createdAt       DateTime
  metadata        String?
  activeSessions  Session[]
  members         Member[]
  invitations     Invitation[]
  prospects       Prospect[]
  offers          Offer[]
  researchRuns    ResearchRun[]
  evidenceSources EvidenceSource[]
  evidenceItems   Evidence[]
  dealBriefs      DealBrief[]
  notifications   Notification[]
  briefShares     BriefShare[]

  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// Landing-page signups are leads, not authenticated identities.
model WaitlistSignup {
  id                String    @id @default(cuid())
  name              String?
  email             String    @unique
  createdAt         DateTime  @default(now())
  launchEmailSentAt DateTime?
  launchEmailId     String?
}

model Prospect {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  name           String
  email          String?
  companyName    String?
  companyDomain  String?
  linkedinUrl    String?
  xHandle        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  researchRuns   ResearchRun[]

  @@unique([id, organizationId])
  @@index([organizationId, updatedAt])
  @@index([createdById])
  @@map("prospect")
}

model Offer {
  id               String        @id @default(cuid())
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById      String?
  createdBy        User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  name             String
  valueProposition String
  targetPersona    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  researchRuns     ResearchRun[]

  @@unique([id, organizationId])
  @@index([organizationId, updatedAt])
  @@index([createdById])
  @@map("offer")
}

// One asynchronous request to connect a prospect's current situation to an
// offer. Workers may advance the status but cannot cross the workspace key.
model ResearchRun {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prospectId     String
  prospect       Prospect         @relation(fields: [prospectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  offerId        String
  offer          Offer            @relation(fields: [offerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdById    String?
  createdBy      User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  goal           String
  status         String           @default("queued")
  requestedAt    DateTime         @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  errorMessage   String?
  inputSnapshot  Json
  // Postgres queue locks. The API does not set these; the Python worker claims running rows.
  lockedAt       DateTime?
  lockExpiresAt  DateTime?
  workerId       String?
  attemptCount   Int              @default(0)
  sources        EvidenceSource[]
  evidence       Evidence[]
  brief          DealBrief?
  notifications  Notification[]

  @@unique([id, organizationId])
  @@index([organizationId, status, requestedAt])
  @@index([status, lockExpiresAt, requestedAt])
  @@index([prospectId, organizationId])
  @@index([offerId, organizationId])
  @@index([createdById])
  @@map("research_run")
}

model EvidenceSource {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  researchRunId  String
  researchRun    ResearchRun  @relation(fields: [researchRunId, organizationId], references: [id, organizationId], onDelete: Cascade)
  url            String
  title          String
  publisher      String?
  sourceType     String
  publishedAt    DateTime?
  retrievedAt    DateTime     @default(now())
  excerpt        String?
  metadata       Json?
  evidence       Evidence[]

  @@unique([id, organizationId])
  @@unique([researchRunId, organizationId, url])
  @@index([organizationId, retrievedAt])
  @@map("evidence_source")
}

// A normalized, citable claim. The compound source relation guarantees that
// evidence can never cite a source from another tenant.
model Evidence {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  researchRunId  String
  researchRun    ResearchRun    @relation(fields: [researchRunId, organizationId], references: [id, organizationId], onDelete: Cascade)
  sourceId       String
  source         EvidenceSource @relation(fields: [sourceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  claim          String
  signalType     String
  confidence     Float
  observedAt     DateTime?
  createdAt      DateTime       @default(now())

  @@unique([id, organizationId])
  @@index([researchRunId, organizationId, createdAt])
  @@index([sourceId, organizationId])
  @@map("evidence")
}

model DealBrief {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  researchRunId     String
  researchRun       ResearchRun  @relation(fields: [researchRunId, organizationId], references: [id, organizationId], onDelete: Cascade)
  title             String
  status            String       @default("draft")
  sections          Json
  previousSections  Json?
  generatedAt       DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  share             BriefShare?

  @@unique([researchRunId, organizationId])
  @@index([organizationId, updatedAt])
  @@map("deal_brief")
}

model BriefShare {
  id             String       @id @default(cuid())
  token          String       @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dealBriefId    String       @unique
  dealBrief      DealBrief    @relation(fields: [dealBriefId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  revokedAt      DateTime?

  @@index([organizationId, createdAt])
  @@index([createdById])
  @@map("brief_share")
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  researchRunId  String?
  researchRun    ResearchRun? @relation(fields: [researchRunId, organizationId], references: [id, organizationId], onDelete: Cascade)
  type           String
  title          String
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([userId, readAt, createdAt])
  @@index([organizationId, createdAt])
  @@index([researchRunId, organizationId])
  @@map("notification")
}
