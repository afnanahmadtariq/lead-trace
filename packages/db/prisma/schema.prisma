generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id
  name                String
  email               String               @unique
  emailVerified       Boolean              @default(false)
  image               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  twoFactorEnabled    Boolean?             @default(false)
  sessions            Session[]
  accounts            Account[]
  twoFactors          TwoFactor[]
  members             Member[]
  invitations         Invitation[]
  createdProspects    Prospect[]
  createdOffers       Offer[]
  researchRuns        ResearchRun[]
  notifications       Notification[]
  briefShares         BriefShare[]
  leadSearches        LeadSearch[]
  reviewedLeads       LeadCandidate[]
  ownedContacts       Prospect[]           @relation("ContactOwner")
  ownedDeals          CrmDeal[]
  assignedTasks       CrmTask[]
  crmNotes            CrmNote[]
  calendarConnections CalendarConnection[]

  @@map("user")
}

model Session {
  id                   String        @id
  expiresAt            DateTime
  token                String        @unique
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?
  activeOrganization   Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)
  mfaVerifiedAt        DateTime?

  @@index([userId])
  @@index([activeOrganizationId])
  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

// Better Auth organizations are Lead Trace workspaces and the tenant boundary
// for all prospect, research, evidence, and brief data added later.
model Organization {
  id                  String               @id
  name                String
  slug                String               @unique
  logo                String?
  createdAt           DateTime
  metadata            String?
  activeSessions      Session[]
  members             Member[]
  invitations         Invitation[]
  prospects           Prospect[]
  offers              Offer[]
  researchRuns        ResearchRun[]
  evidenceSources     EvidenceSource[]
  evidenceItems       Evidence[]
  dealBriefs          DealBrief[]
  notifications       Notification[]
  briefShares         BriefShare[]
  crmDeals            CrmDeal[]
  crmNotes            CrmNote[]
  crmTasks            CrmTask[]
  calendarConnections CalendarConnection[]
  calendarMeetings    CalendarMeeting[]

  leadSearches   LeadSearch[]
  leadSources    LeadSource[]
  leadCandidates LeadCandidate[]

  @@map("organization")
}

model Member {
  id                  String               @id
  organizationId      String
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId              String
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendarConnections CalendarConnection[]
  role                String               @default("member")
  createdAt           DateTime

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// Landing-page signups are leads, not authenticated identities.
model WaitlistSignup {
  id                String    @id @default(cuid())
  name              String?
  email             String    @unique
  createdAt         DateTime  @default(now())
  launchEmailSentAt DateTime?
  launchEmailId     String?
}

model Prospect {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  name           String
  email          String?
  companyName    String?
  companyDomain  String?
  linkedinUrl    String?
  xHandle        String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  researchRuns   ResearchRun[]
  emailKey       String?
  ownerId        String?
  owner          User?             @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  jobTitle       String?
  phone          String?
  lifecycle      String            @default("lead")
  deals          CrmDeal[]
  notes          CrmNote[]
  tasks          CrmTask[]
  meetings       CalendarMeeting[]

  leadCandidates LeadCandidate[]

  @@unique([organizationId, emailKey])
  @@unique([id, organizationId])
  @@index([ownerId])
  @@index([organizationId, updatedAt])
  @@index([createdById])
  @@map("prospect")
}

model Offer {
  id               String        @id @default(cuid())
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById      String?
  createdBy        User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  name             String
  valueProposition String
  targetPersona    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  researchRuns     ResearchRun[]

  @@unique([id, organizationId])
  @@index([organizationId, updatedAt])
  @@index([createdById])
  @@map("offer")
}

// One asynchronous request to connect a prospect's current situation to an
// offer. Workers may advance the status but cannot cross the workspace key.
model ResearchRun {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prospectId     String
  prospect       Prospect         @relation(fields: [prospectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  offerId        String
  offer          Offer            @relation(fields: [offerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdById    String?
  createdBy      User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  goal           String
  status         String           @default("queued")
  requestedAt    DateTime         @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  errorMessage   String?
  inputSnapshot  Json
  // Postgres queue locks. The API does not set these; the Python worker claims running rows.
  lockedAt       DateTime?
  lockExpiresAt  DateTime?
  workerId       String?
  attemptCount   Int              @default(0)
  sources        EvidenceSource[]
  evidence       Evidence[]
  brief          DealBrief?
  notifications  Notification[]

  @@unique([id, organizationId])
  @@index([organizationId, status, requestedAt])
  @@index([status, lockExpiresAt, requestedAt])
  @@index([prospectId, organizationId])
  @@index([offerId, organizationId])
  @@index([createdById])
  @@map("research_run")
}

model EvidenceSource {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  researchRunId  String
  researchRun    ResearchRun  @relation(fields: [researchRunId, organizationId], references: [id, organizationId], onDelete: Cascade)
  url            String
  title          String
  publisher      String?
  sourceType     String
  publishedAt    DateTime?
  retrievedAt    DateTime     @default(now())
  excerpt        String?
  metadata       Json?
  evidence       Evidence[]

  @@unique([id, organizationId])
  @@unique([researchRunId, organizationId, url])
  @@index([organizationId, retrievedAt])
  @@map("evidence_source")
}

// A normalized, citable claim. The compound source relation guarantees that
// evidence can never cite a source from another tenant.
model Evidence {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  researchRunId  String
  researchRun    ResearchRun    @relation(fields: [researchRunId, organizationId], references: [id, organizationId], onDelete: Cascade)
  sourceId       String
  source         EvidenceSource @relation(fields: [sourceId, organizationId], references: [id, organizationId], onDelete: Restrict)
  claim          String
  signalType     String
  confidence     Float
  observedAt     DateTime?
  createdAt      DateTime       @default(now())

  @@unique([id, organizationId])
  @@index([researchRunId, organizationId, createdAt])
  @@index([sourceId, organizationId])
  @@map("evidence")
}

model DealBrief {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  researchRunId    String
  researchRun      ResearchRun  @relation(fields: [researchRunId, organizationId], references: [id, organizationId], onDelete: Cascade)
  title            String
  status           String       @default("draft")
  sections         Json
  previousSections Json?
  generatedAt      DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  share            BriefShare?

  @@unique([researchRunId, organizationId])
  @@index([organizationId, updatedAt])
  @@map("deal_brief")
}

model BriefShare {
  id             String       @id @default(cuid())
  token          String       @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dealBriefId    String       @unique
  dealBrief      DealBrief    @relation(fields: [dealBriefId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  revokedAt      DateTime?

  @@index([organizationId, createdAt])
  @@index([createdById])
  @@map("brief_share")
}

model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  researchRunId  String?
  researchRun    ResearchRun? @relation(fields: [researchRunId, organizationId], references: [id, organizationId], onDelete: Cascade)
  type           String
  title          String
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([userId, readAt, createdAt])
  @@index([organizationId, createdAt])
  @@index([researchRunId, organizationId])
  @@map("notification")
}

// CRM extends existing prospects so earlier research remains attached.
model CrmDeal {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prospectId      String
  prospect        Prospect     @relation(fields: [prospectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  ownerId         String?
  owner           User?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  title           String
  stage           String       @default("new")
  value           Decimal      @default(0) @db.Decimal(14, 2)
  currency        String       @default("USD")
  expectedCloseAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId, stage, updatedAt])
  @@index([prospectId, organizationId])
  @@index([ownerId])
  @@map("crm_deal")
}

model CrmNote {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prospectId     String
  prospect       Prospect     @relation(fields: [prospectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  authorId       String?
  author         User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body           String
  createdAt      DateTime     @default(now())

  @@index([prospectId, organizationId, createdAt])
  @@index([organizationId])
  @@index([authorId])
  @@map("crm_note")
}

model CrmTask {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prospectId     String
  prospect       Prospect     @relation(fields: [prospectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  ownerId        String?
  owner          User?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  title          String
  dueAt          DateTime
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, completedAt, dueAt])
  @@index([prospectId, organizationId])
  @@index([ownerId])
  @@map("crm_task")
}

model CalendarConnection {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership      Member       @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade, map: "calendar_connection_membership_fkey")
  encryptedTokens String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("calendar_connection")
}

model CalendarMeeting {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prospectId     String
  prospect       Prospect     @relation(fields: [prospectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organizerId    String
  title          String
  startsAt       DateTime
  endsAt         DateTime
  inviteContact  Boolean      @default(false)
  attendeeEmail  String?
  googleEventId  String
  htmlLink       String?
  status         String       @default("pending")
  createdAt      DateTime     @default(now())

  @@index([prospectId, organizationId, startsAt])
  @@index([organizationId, organizerId])
  @@map("calendar_meeting")
}

// Immutable search criteria and source snapshots support review before CRM import.
model LeadSearch {
  id                 String          @id @default(cuid())
  organizationId     String
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById        String?
  createdBy          User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  title              String
  industry           String
  role               String
  location           String?
  keywords           String?
  depth              String          @default("deep")
  roleMatch          String          @default("function")
  phase              String?
  progress           Json?
  diagnostics        Json?
  companySnapshots   Json?
  status             String          @default("queued")
  errorMessage       String?
  queries            Json?
  failedQueries      Int             @default(0)
  rejectedCandidates Int             @default(0)
  attemptCount       Int             @default(0)
  attemptToken       String?
  lockExpiresAt      DateTime?
  createdAt          DateTime        @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  sources            LeadSource[]
  candidates         LeadCandidate[]

  @@unique([id, organizationId])
  @@index([organizationId, createdAt])
  @@index([createdById])
  @@index([status, lockExpiresAt, createdAt])
  @@map("lead_search")
}

model LeadSource {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  searchId       String
  search         LeadSearch      @relation(fields: [searchId, organizationId], references: [id, organizationId], onDelete: Cascade)
  url            String
  title          String
  excerpt        String
  publisher      String
  provider       String          @default("tavily")
  sourceKind     String          @default("search")
  queries        String[]
  retrievedAt    DateTime        @default(now())
  candidates     LeadCandidate[]

  @@unique([id, searchId, organizationId])
  @@unique([searchId, organizationId, url])
  @@index([organizationId])
  @@map("lead_source")
}

model LeadCandidate {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  searchId        String
  search          LeadSearch   @relation(fields: [searchId, organizationId], references: [id, organizationId], onDelete: Cascade)
  sourceId        String
  source          LeadSource   @relation(fields: [sourceId, searchId, organizationId], references: [id, searchId, organizationId], onDelete: Cascade)
  identityKey     String
  name            String
  companyName     String
  jobTitle        String?
  quote           String
  matchedCriteria String[]
  missingCriteria String[]
  qualification   Json?
  status          String       @default("new")
  reviewedById    String?
  reviewedBy      User?        @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  prospectId      String?
  prospect        Prospect?    @relation(fields: [prospectId, organizationId], references: [id, organizationId], onDelete: Cascade)
  createdAt       DateTime     @default(now())

  @@unique([id, organizationId])
  @@unique([searchId, identityKey])
  @@index([organizationId, status, createdAt])
  @@index([sourceId, searchId, organizationId])
  @@index([prospectId, organizationId])
  @@index([reviewedById])
  @@map("lead_candidate")
}
