{
  "name": "lead-trace",
  "private": true,
  "packageManager": "npm@12.0.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf .turbo",
    "worker:setup": "npm run setup --workspace=@lead-trace/worker",
    "worker:process": "npm run process --workspace=@lead-trace/worker",
    "db:generate": "npm run db:generate --workspace=@lead-trace/db",
    "db:migrate": "npm run db:migrate --workspace=@lead-trace/db",
    "db:migrate:dev": "npm run db:migrate:dev --workspace=@lead-trace/db"
  },
  "dependencies": {
    "turbo": "^2.10.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "mysql2": "3.24.3",
    "rimraf": "^6.1.3",
    "typescript-eslint": "^8.68.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "$mysql2"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "prisma@7.10.0": true,
    "sharp@0.35.2": true,
    "sharp@0.35.4": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20260820.1": true
  }
}
