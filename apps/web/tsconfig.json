{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next-e2e-3000/types/**/*.ts",
    ".next-e2e-3000/dev/types/**/*.ts",
    ".next-e2e-3100/types/**/*.ts",
    ".next-e2e-3100/dev/types/**/*.ts",
    ".next-e2e-3130/types/**/*.ts",
    ".next-e2e-3130/dev/types/**/*.ts",
    ".next-e2e-3132/types/**/*.ts",
    ".next-e2e-3132/dev/types/**/*.ts",
    ".next-e2e-3200/types/**/*.ts",
    ".next-e2e-3200/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "e2e"
  ]
}
