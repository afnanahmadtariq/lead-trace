{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "generate"],
      "env": ["DATABASE_URL"],
      "outputs": ["dist/**", "build/**", "generated/**", ".next/**", ".nuxt/**", ".output/**"]
    },
    "generate": {
      "env": ["DATABASE_URL"],
      "outputs": ["generated/**"]
    },
    "clean": {
      "cache": false
    },
    "check-types": {
      "dependsOn": ["^check-types", "generate"],
      "env": ["DATABASE_URL"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["build", "^build"],
      "env": [
        "DATABASE_URL",
        "E2E_API_PORT",
        "E2E_SEED_SECRET",
        "E2E_USE_REAL_STACK",
        "E2E_WEB_PORT",
        "PLAYWRIGHT_API_URL",
        "PLAYWRIGHT_BASE_URL"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "BETTER_AUTH_*",
        "WEB_ORIGIN",
        "NEXT_PUBLIC_*",
        "LISTEN_HOST",
        "PORT",
        "GOOGLE_CLIENT_*",
        "GOOGLE_CALENDAR_*",
        "INTEGRATION_ENCRYPTION_KEY",
        "RESEND_*",
        "TAVILY_*",
        "DASHSCOPE_*",
        "OPENAI_*",
        "WORKER_*",
        "E2E_*",
        "DEMO_CAPTURE"
      ]
    }
  }
}
